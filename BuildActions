local sfxFolder = SoundService:FindFirstChild("SFX")
local placeSoundTemplate = sfxFolder and sfxFolder:FindFirstChild("Object Placed")
local deleteSoundTemplate = sfxFolder and sfxFolder:FindFirstChild("Object Deleted")

local function playBuildSound(template)
	if template and template.SoundId ~= "" then
		local sound = template:Clone()
		sound.Parent = SoundService
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		sound:Play()
	end
end

events.PlacementResult.OnClientEvent:Connect(function(result)
	-- ITEM #11: A DRAG STROKE IS ONE UNDO STEP.
	--
	-- The server stamps every placement produced by one drag with the same
	-- BatchId, so the second and subsequent results fold into the entry the
	-- first one created rather than each pushing their own. Undo then removes
	-- the whole stroke in a single keypress.
	--
	-- Previously each tile pushed its own entry, so Ctrl+Z appeared to "skip":
	-- it was consuming one tile per press while the player expected the stroke.
	-- Worse for floor drags -- the server collapses those into a single part, so
	-- most of the per-tile entries referred to BuildIds that never existed and
	-- silently did nothing, walking the stack pointer back into unrelated
	-- history.
	if BuildHistory.appendToBatch(result.BatchId, result.ObjectId) then
		return -- merged into the stroke already on the stack; no duplicate sound
	end

	BuildHistory.pushUndo({
		action = result.BatchId and "BATCH_PLACE" or "Place",
		batchId = result.BatchId,
		objectName = result.ObjectName,
		cframe = result.CF,
		objectId = result.ObjectId,
		objectIds = result.BatchId and { result.ObjectId } or nil,
	})

	-- Local-only thunk -- only the person placing hears it, not the whole server
	playBuildSound(placeSoundTemplate)
end)

-- ITEM #11: VALID INSTANCE VERIFICATION.
--
-- An undo entry holds a BuildId, not a live reference, and plenty can happen to
-- the object behind it between the action and the undo -- a co-builder with
-- WorkBuild permission can delete it, the owner can Clear Plot, or the server
-- can reject a placement the client optimistically recorded. Firing a remote
-- for a BuildId that no longer resolves is not harmful on its own (the server
-- looks it up and returns), but it silently consumes a stack entry, which is
-- what makes undo feel like it "skips".
--
-- So an entry is checked against the live plot BEFORE it is spent. Ids that no
-- longer exist are dropped from the entry; an entry with nothing left is
-- discarded and the next one is tried instead.
local function objectExists(plot: Model?, objectId: number?): boolean
	if not plot or not objectId then return false end
	local buildObjects = plot:FindFirstChild("BuildObjects")
	if not buildObjects then return false end
	for _, obj in ipairs(buildObjects:GetChildren()) do
		if obj:GetAttribute("BuildId") == objectId then return true end
	end
	return false
end

-- Keeps only the ids in `action` that still resolve on `plot`. Returns the
-- surviving list. For a Delete entry the objects are SUPPOSED to be gone, so
-- existence is not required -- only the presence of an id to restore.
local function liveIdsFor(action, plot: Model?, requireLive: boolean): { number }
	local ids = BuildHistory.idsOf(action)
	if not requireLive then return ids end

	local live = {}
	for _, id in ipairs(ids) do
		if objectExists(plot, id) then table.insert(live, id) end
	end
	return live
end

undoButton.MouseButton1Click:Connect(function()
	-- TargetPlot travels with every mutation (ITEM #10). The server re-verifies
	-- it against CanPlayerBuild and falls back to its own resolution if it
	-- disagrees, so this is a hint, never an authority.
	local targetPlot = getPlot()

	-- Loops rather than doing one pass: an entry whose objects have all been
	-- destroyed by someone else is skipped and the NEXT one is undone, so one
	-- press always performs one visible undo.
	while BuildHistory.undoCount() > 0 do
		local action = BuildHistory.popUndo()

		if action.action == "Place" or action.action == "BATCH_PLACE" then
			local ids = liveIdsFor(action, targetPlot, true)
			if #ids > 0 then
				for _, id in ipairs(ids) do
					events.DeleteObject:FireServer({ObjectId = id, Reason = "undo", TargetPlot = targetPlot})
				end
				-- Redo must replay exactly what was undone, not what was originally
				-- placed -- ids that had already been destroyed are not coming back.
				action.objectIds = (#ids > 1) and ids or nil
				action.objectId = ids[1]
				playBuildSound(deleteSoundTemplate)
				BuildHistory.pushRedo(action)
				return
			end
			-- Nothing left of this stroke: drop it and try the next entry.

		elseif action.action == "Delete" then
			local ids = BuildHistory.idsOf(action)
			if #ids > 0 then
				for _, id in ipairs(ids) do
					events.RestoreObject:FireServer({ObjectId = id, Reason = "undo", TargetPlot = targetPlot})
				end
				playBuildSound(placeSoundTemplate)
				BuildHistory.pushRedo(action)
				return
			end

		elseif action.action == "Move" then
			if objectExists(targetPlot, action.objectId) then
				events.MoveObject:FireServer({ObjectId = action.objectId, CF = action.oldCF, TargetPlot = targetPlot})
				BuildHistory.pushRedo(action)
				return
			end
		end
	end
end)

redoButton.MouseButton1Click:Connect(function()
	local targetPlot = getPlot()

	while BuildHistory.redoCount() > 0 do
		local action = BuildHistory.popRedo()

		if action.action == "Place" or action.action == "BATCH_PLACE" then
			local ids = BuildHistory.idsOf(action)
			if #ids > 0 then
				for _, id in ipairs(ids) do
					events.RestoreObject:FireServer({ObjectId = id, Reason = "redo", TargetPlot = targetPlot})
				end
				playBuildSound(placeSoundTemplate)
				-- pushUndo, NOT pushRedo: re-entering the undo stack is the whole
				-- point of redo. It also clears the remaining redo branch, which is
				-- correct -- see BuildHistory's note on branch invalidation.
				table.insert(BuildHistory.undoStack, action)
				return
			end

		elseif action.action == "Delete" then
			local ids = liveIdsFor(action, targetPlot, true)
			if #ids > 0 then
				for _, id in ipairs(ids) do
					events.DeleteObject:FireServer({ObjectId = id, Reason = "redo", TargetPlot = targetPlot})
				end
				playBuildSound(deleteSoundTemplate)
				table.insert(BuildHistory.undoStack, action)
				return
			end

		elseif action.action == "Move" then
			if objectExists(targetPlot, action.objectId) then
				events.MoveObject:FireServer({ObjectId = action.objectId, CF = action.newCF, TargetPlot = targetPlot})
				table.insert(BuildHistory.undoStack, action)
				return
			end
		end
	end
end)

