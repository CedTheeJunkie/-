end)

events.ToggleCollisions.OnClientEvent:Connect(function(disabled: boolean)
	collisionDisabled = disabled
	-- This is the actual flag PlacingService/Validation checks to decide
	-- whether an overlapping placement is allowed. It was never being set
	-- anywhere, so the placement preview kept rejecting overlaps as "invalid"
	-- no matter what this toggle (or gamepass ownership) said -- the button
	-- would light up green but placement still behaved as if collision was on.
	Settings.CanOverlapWithOtherParts = disabled
	if disabled then
		collisionButton.ImageColor3 = Color3.fromRGB(100, 200, 100)
	else
		collisionButton.ImageColor3 = originalCollisionColor
	end
end)

buildGui:GetPropertyChangedSignal("Enabled"):Connect(function()
	if not buildGui.Enabled then
		exitDeleteMode()
		-- ITEM #11: history does not survive the session.
		--
		-- Entries are BuildIds scoped to the plot that was being built on. Keeping
		-- them across a close/reopen meant that a player who built on their own
		-- plot, walked to a friend's and reopened Build Mode could press undo and
		-- have it fire against the FRIEND's plot -- where the same BuildId either
		-- matches nothing or, because ids come from one server-wide counter,
		-- matches an unrelated object.
		BuildHistory.reset()
	end
end)
