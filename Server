-- ClearPlot ("Demolish my plot") -- the client's type-your-name textbox is a
-- UX safety net against misclicks only. The only thing that actually matters
-- here server-side is that the firing player owns the plot being wiped, which
-- getActingPlot() already guarantees -- an exploiter firing this directly
-- skips the confirmation, not the ownership check.
ReplicatedStorage.RemoteEvents.ClearPlot.OnServerEvent:Connect(function(player: Player)
	local rateLimiter = cachedModules.RateLimiter
	if rateLimiter and not rateLimiter.guard(player, "ClearPlot", 2, 10) then return end

	local plot = getActingPlot(player)
	if not assertCanBuild(player, plot) then return end

	-- Send customers on their way and clear employees first, same as entering
	-- Build Mode -- otherwise their AI can end up referencing a rack/register
	-- that's about to be destroyed out from under them.
	local npcController = cachedModules.NPCController
	if npcController and npcController.releasePlotNPCs then
		npcController.releasePlotNPCs(plot)
	end

	-- ITEM #9: flag every object as invalidated before the wholesale clear, so
	-- any NPC mid-walk toward one of them drops its reference on this frame
	-- rather than arriving at a destroyed model.
	do
		local existing = plot:FindFirstChild("BuildObjects")
		if existing then
			for _, obj in existing:GetChildren() do
				notifyObjectRemoved(plot, obj)
			end
		end
	end

	local employeeService = cachedModules.EmployeeService
	if employeeService and employeeService.hideOwnedEmployees then
		employeeService.hideOwnedEmployees(player)
	end

	local buildObjects = plot:FindFirstChild("BuildObjects")
	if buildObjects then
		buildObjects:ClearAllChildren()
	end

	savePlotForPlot(plot, player)

	-- Employees have nowhere left to stand until the player re-places a
	-- register, but respawning now (rather than leaving them hidden forever)
	-- means they're ready to go the moment a new register goes down.
	if employeeService and employeeService.respawnOwnedEmployees then
		employeeService.respawnOwnedEmployees(player)
	end

	ReplicatedStorage.RemoteEvents.ClearPlot:FireClient(player)
end)

-- Cleanup on player leave
Players.PlayerRemoving:Connect(function(player: Player)
	collisionDisabled[player] = nil

	-- trashStore entries are undo-delete records with no TTL -- without this
	-- they accumulate forever across a long-running multi-player server as
	-- people build/delete things and never hit undo, one leaked entry per
	-- delete. Purge this player's on the way out.
	for objectId, entry in pairs(trashStore) do
		if entry.OwnerId == player.UserId then
			trashStore[objectId] = nil
		end
	end
end)
