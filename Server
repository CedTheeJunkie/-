	if plotService and plotService.savePlotState then
		plotService.savePlotState(player)
	end
end

local function savePlotForPlot(plot: Model?, actingPlayer: Player)
	local owner = getPlotOwner(plot)
	savePlotState(owner or actingPlayer)

	-- Rescore the store the moment its contents change. The rating used to move
	-- only on StoreRatingService's 7-second pulse, so placing or deleting
	-- something appeared to do nothing for up to seven seconds -- which reads as
	-- "the decor score is broken" rather than "the decor score is late", and is
	-- long enough for a player to place several more items wondering why the
	-- number never moves.
	--
	-- Hooked HERE, at the one function every place / delete / store / clear path
	-- already funnels through, rather than at each of those call sites, so a
	-- future build action cannot forget to trigger it. requestRefresh coalesces
	-- per frame, so a drag laying 30 tiles still only rescores once.
	local storeRatingService = cachedModules.StoreRatingService
	if plot and storeRatingService and storeRatingService.requestRefresh then
		storeRatingService.requestRefresh(plot)
	end
end

