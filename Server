end

ReplicatedStorage.RemoteEvents.Teleport.OnServerEvent:Connect(function(plr, destinationKey)
	if not cachedModules.RateLimiter or not cachedModules.RateLimiter.guard(plr, "Teleport", 6, 5) then return end
	if typeof(destinationKey) ~= "string" then return end

	local character = plr.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local targetPart: BasePart? = nil

	if destinationKey == "Shop" then
		local shop = workspace:FindFirstChild("Shop")
		targetPart = shop and shop:FindFirstChild("SpawnLocation") :: BasePart?
	elseif destinationKey == "Home" then
		local plot = getOwnedPlot(plr)
		targetPart = plot and plot:FindFirstChild("SpawnLocation") :: BasePart?
	end

	if not targetPart or not targetPart:IsA("BasePart") then return end

	hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
end)

local buildIdCounter = 1

-- ITEM #11/#12: identifies all placements produced by ONE drag, so the client's
-- undo stack can group them into a single atomic entry (and the paint/delete
-- tools can address the whole patch). Server-assigned rather than client-timed:
-- PlacementResult events replicate individually and can interleave with an
-- unrelated placement, so "arrived close together" is not a safe grouping key.
local batchIdCounter = 0
local function nextBatchId(): string
	batchIdCounter += 1
	return "batch#" .. tostring(batchIdCounter)
end
local trashStore: {[number]: {Name: string, CF: CFrame, Attributes: {[string]: any}}} = {}

-- ITEM #5: the No-Collision / Overlap-Allowed toggle.
--
-- This flag has always existed CLIENT-side: BuildActions sets
-- `Settings.CanOverlapWithOtherParts`, and Validation honours it, so the
-- preview stops showing red. But Settings is a ModuleScript, and the server
-- holds its OWN copy of it whose flag nobody ever set -- so the server kept
-- running the full overlap test and rejecting every placement the client had
-- just shown as legal. That is the whole "the button lights up green but I
-- still can't place anything" bug.
--
-- Tracked per player here (a ModuleScript flag on the server would be shared
-- by everyone on the shard -- one player toggling it would disable overlap
-- validation for the entire server) and threaded explicitly into
-- validatePlacementServerSide.
--
-- The PLOT BOUNDARY CLAMP is deliberately NOT part of this: bypassing overlap
-- lets you put a rack through a wall, never outside your own land.
local collisionDisabled: {[Player]: boolean} = {}

local function overlapBypassed(player: Player): boolean
	return collisionDisabled[player] == true
end

local function findBuildAsset(objectName: string): Instance?
	local buildMode = ReplicatedStorage:FindFirstChild("BuildMode")
	local assets = buildMode and buildMode:FindFirstChild("Assets")
	if not assets then return nil end
	for _, folder in assets:GetChildren() do
		if folder:IsA("Folder") then
			local object = folder:FindFirstChild(objectName)
			if object then return object end
		end
	end
	return nil
end

local function getRepresentativePart(asset: Instance): BasePart?
	if asset:IsA("BasePart") then
		return asset
	elseif asset:IsA("Model") then
		return asset.PrimaryPart or asset:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function isWithinPlotBounds(plot: Model, position: Vector3, marginStuds: number?): boolean
	local base = plot:FindFirstChild("Base")
	if not base or not base:IsA("BasePart") then return false end
	local margin = marginStuds or 0
	local halfExtents = Vector3.new(base.Size.X / 2 + margin, base.Size.Y / 2 + 1000, base.Size.Z / 2 + margin)
	local localPos = base.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= halfExtents.X
		and math.abs(localPos.Y) <= halfExtents.Y
		and math.abs(localPos.Z) <= halfExtents.Z
end

local function isWithinOwnedLand(plot: Model, position: Vector3): boolean
	local bounds = plot:FindFirstChild("PlotBounds")
	if not bounds or not bounds:IsA("BasePart") then return true end -- fail open if not set up yet
	local halfExtents = Vector3.new(bounds.Size.X / 2, bounds.Size.Y / 2 + 1000, bounds.Size.Z / 2)
	local localPos = bounds.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= halfExtents.X
		and math.abs(localPos.Y) <= halfExtents.Y
		and math.abs(localPos.Z) <= halfExtents.Z
end

local function checkOwnedLand(player: Player, plot: Model, position: Vector3): boolean
	if isWithinOwnedLand(plot, position) then return true end
	local clientNotify = cachedModules.ClientNotifyService
	if clientNotify then
		clientNotify.notify(player, "Decline", "Buy more land!")
	end
	return false
end

-- ITEM #10: SERVER-SIDE BUILD TARGET RESOLUTION.
--
-- Every build remote resolves the plot it is about to mutate through here.
--
-- `requestedPlot` is the client's stated intent (Build Mode tells the server
-- which plot it opened against). It is treated as a HINT and nothing more: it
-- is accepted only when it is a real plot AND the server independently agrees
-- the player may build on it. A client that lies gets its own resolution
-- instead, never an error it could use to probe.
--
-- Returning nil means "this player may not build anywhere right now", and every
-- caller must treat that as a hard stop.
local function getActingPlot(player: Player, requestedPlot: any?): Model?
	local plotService = cachedModules.PlotService
	if not plotService then return nil end

	if typeof(requestedPlot) == "Instance"
		and requestedPlot:IsA("Model")
		and requestedPlot.Parent == workspace:FindFirstChild("Plots")
	then
		-- CanPlayerBuild is the authority. The player must also actually be at
		-- the plot -- otherwise a granted friend could build remotely in a store
		-- on the other side of the map while standing in their own.
		if plotService.CanPlayerBuild(player, requestedPlot) then
			local serverResolved = plotService.resolveActingPlot(player, true)
			if serverResolved == requestedPlot then
				return requestedPlot
			end
		end
	end

	return plotService.getActingPlot(player, true)
end

-- Final gate immediately before any mutation. getActingPlot already implies
-- permission, but re-asserting it here means a future caller that resolves a
-- plot some other way still cannot skip the check.
local function assertCanBuild(player: Player, plot: Model?): boolean
	if not plot then return false end
	local plotService = cachedModules.PlotService
	if not plotService then return false end
	if plotService.CanPlayerBuild(player, plot) then return true end

	local clientNotify = cachedModules.ClientNotifyService
	if clientNotify then
		clientNotify.notify(player, "Decline", "You do not have permission to build here!")
	end
	return false
end

local function getPlotOwner(plot: Model?): Player?
	if not plot then return nil end
	local ownerId = plot:GetAttribute("USERID")
	if typeof(ownerId) ~= "number" or ownerId == 0 then return nil end
	return Players:GetPlayerByUserId(ownerId)
end

local function getBuildObjectsFolder(plot: Model): Folder
	local buildObjects = plot:FindFirstChild("BuildObjects")
	if not buildObjects then
		buildObjects = Instance.new("Folder")
		buildObjects.Name = "BuildObjects"
		buildObjects.Parent = plot
	end
	return buildObjects :: Folder
end

local function findObjectByBuildId(plot: Model, buildId: number): Instance?
	local buildObjects = plot:FindFirstChild("BuildObjects")
	if not buildObjects then return nil end
	for _, obj in buildObjects:GetChildren() do
		if obj:GetAttribute("BuildId") == buildId then return obj end
	end
