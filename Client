local function updateAreaPreviewBox(startCF: CFrame, endCF: CFrame, canPlace: boolean?)
	local box = getOrCreateAreaPreviewBox()
	local stepX, stepZ = getTileStep()

	local minX, maxX = math.min(startCF.X, endCF.X), math.max(startCF.X, endCF.X)
	local minZ, maxZ = math.min(startCF.Z, endCF.Z), math.max(startCF.Z, endCF.Z)

	-- Sized off the TILE footprint, matching what the server actually builds.
	-- Previously this added Settings.GridUnit (1) while the server added the
	-- tile's real width (8), so the ghost box was 7 studs smaller than the floor
	-- you ended up with.
	box.Size = Vector3.new((maxX - minX) + stepX, 0.2, (maxZ - minZ) + stepZ)
	box.CFrame = CFrame.new((minX + maxX) / 2, startCF.Y + 0.15, (minZ + maxZ) / 2)

	-- Color-code based on validity (green for valid, red for invalid)
	box.Color = (canPlace == false) and cannotPlaceColor or canPlaceColor

	-- Update tile count display
	local tilesX = math.floor((maxX - minX) / stepX + 0.5) + 1
	local tilesZ = math.floor((maxZ - minZ) / stepZ + 0.5) + 1
	if areaTileLabel then
		areaTileLabel.Text = string.format("%d tiles", tilesX * tilesZ)
	end
end

local function hideAreaPreviewBox()
	if areaPreviewBox then
		areaPreviewBox.Parent = nil
	end
end

-- Builds one CFrame per grid cell spanning the rectangle between the drag's
-- start and end points, all sharing the same rotation/height as the start
-- (floor tiles are already Y-snapped flush to the plot floor by PlacingService).
local function computeAreaCFrames(startCF: CFrame, endCF: CFrame): {CFrame}
	local stepX, stepZ = getTileStep()
	local rotationOnly = startCF - startCF.Position

	local minX, maxX = math.min(startCF.X, endCF.X), math.max(startCF.X, endCF.X)
	local minZ, maxZ = math.min(startCF.Z, endCF.Z), math.max(startCF.Z, endCF.Z)

	-- One entry per TILE, not per stud -- this count is what the server charges
	-- for, so it has to mean "tiles".
	local cframes = {}
	local x = minX
	while x <= maxX + 0.01 do
		local z = minZ
		while z <= maxZ + 0.01 do
			table.insert(cframes, CFrame.new(x, startCF.Y, z) * rotationOnly)
			z += stepZ
		end
		x += stepX
	end
	return cframes
end

-- ===== MULTI-PLACE DRAG (rows / blocks of any item) =====
--
-- Floors already had drag-to-fill (above), but it's a special case: the server
-- collapses a floor drag into ONE stretched part so the material UV stays
-- continuous. Everything else -- racks, furniture, registers, mannequins --
-- has to stay N discrete objects, each individually movable, sellable and
-- interactable, so it needs its own path.
--
-- Why a toggle instead of "just drag":
-- press-and-drag on a non-floor item ALREADY means free-rotate (the
-- Bloxburg-style hold-to-spin). Overloading the same gesture would make it
-- guesswork whether a drag was meant to turn one rack or lay down eight. The
-- toggle keeps both gestures unambiguous, and gives touch players a visible
-- affordance instead of a hidden gesture -- rotation stays available in
-- multi mode via the Rotate button / R key.
local MAX_MULTI_ITEMS = 60 -- hard cap; also mirrored server-side
local MULTI_DRAG_THRESHOLD = 3 -- same responsiveness as the floor drag

-- ===== MOBILE: MOVE MODE =====
--
-- On touch, releasing a finger anywhere on the world PLACES the item (see the
-- InputEnded handler in startPlacing). That makes positioning and committing the
-- same gesture: you cannot drag an item into place without also dropping it
-- where your finger happens to leave the screen, and the preview is under your
-- thumb the whole time so you cannot see what you are aiming at.
--
-- Move mode separates them. While it is on, dragging repositions the preview and
-- lifting your finger does NOT commit -- placement happens only via the explicit
-- Place button. Camera panning is suppressed for the duration so the world does
-- not slide under the item being positioned (BuildCameraController honours
-- PlacingService.IsMobileMoving, the same way it already honours
-- PlacingService.IsDragRotating).
--
-- Declared here, alongside the other placement-mode state, because the input
-- handlers inside startPlacing close over it long before the button that toggles
-- it is built.
local TOUCH_ENABLED: boolean = UserInputS.TouchEnabled
local mobileMoveMode = false
