-- EVERY placement type can now be dragged. The earlier restriction to
-- Floor/Ceiling was caution, not a technical limit -- the concerns turned out
-- to be handled elsewhere:
--
--   Wall              -- magnetic endpoint snapping only positions the LIVE
--                        preview; the fill extends from wherever that lands, so
--                        the two don't fight. Stepping by the wall's own length
--                        makes a dragged run butt together seamlessly.
--   WallSurface       -- shelves/mirrors. The server already raycasts behind
--   FloorWallAnchored    each one and rejects (and refunds) any that has no
--                        wall behind it, so a row that runs off the end of a
--                        wall self-trims instead of leaving floating items.
--   SurfaceTop        -- decorations on furniture. Needed a new server-side
--                        check (see PlaceMulti) that each copy actually lands
--                        on a SurfaceZone, otherwise a row could float off the
--                        end of a table.
local function supportsMultiPlace(): boolean
	local preview = PlacingService.GetPreview()
	if not preview then return false end
	-- Anything that area-fills (floors, ceiling tiles) has its own dedicated
	-- drag path -- don't double-handle it here.
	if isAreaFillPlacement() then return false end

	-- Walls and doors are DELIBERATELY excluded. They use edge-based placement
	-- now (one wall per grid edge, orientation taken from the edge), and a
	-- rectangle fill has no sensible meaning on an edge lattice. Re-enabling is
	-- a one-line change: delete this block.
	if PlacementTypeConfig.Get(preview) == PlacementTypeConfig.Types.Wall then
		return false
	end

	return true
end

-- Can this item be dragged at all, by either path?
local function supportsAnyDrag(): boolean
	return isAreaFillPlacement() or supportsMultiPlace()
end

-- The item's own footprint in ITS OWN local frame, rounded UP to a whole number
-- of grid units. Two reasons it's rounded rather than used raw:
--   * stepping by a raw footprint that isn't a grid multiple walks the row
--     progressively off the grid PlacingService snaps single placements to, so
--     item 6 no longer lines up with anything placed normally;
--   * rounding up (never down) guarantees neighbours butt against each other
--     instead of intersecting, which the server would reject as an overlap.
local function getMultiStep(): (number, number)
	local preview = PlacingService.GetPreview()
	local gridUnit = PlacingService.GridUnit or Settings.GridUnit or 1
	if not preview then return gridUnit, gridUnit end

	local size: Vector3
	if preview:IsA("Model") then
		local _, boundsSize = preview:GetBoundingBox()
		size = boundsSize
	else
		size = preview.Size
	end

	local function stepFor(axisSize: number): number
		local units = math.max(1, math.ceil((math.abs(axisSize) - 0.01) / gridUnit))
		return units * gridUnit
	end

	return stepFor(size.X), stepFor(size.Z)
end

-- One CFrame per slot in the rectangle spanned by the drag, laid out in the
-- START item's local frame so a rotated row runs along the way the item is
-- actually facing rather than along world X/Z.
--
-- A drag that stays within one step on an axis yields a count of 1 there, so a
-- straight drag naturally produces a single line and a diagonal one fills the
-- block -- no separate "line mode" needed.
local function computeMultiCFrames(startCF: CFrame, endCF: CFrame): {CFrame}
	local stepX, stepZ = getMultiStep()
	local delta = startCF:VectorToObjectSpace(endCF.Position - startCF.Position)

	local countX = math.floor(math.abs(delta.X) / stepX + 0.5) + 1
	local countZ = math.floor(math.abs(delta.Z) / stepZ + 0.5) + 1

	-- Clamp the LONGER axis first so a runaway diagonal degrades into a long
	-- row rather than silently truncating into a lopsided block.
	while countX * countZ > MAX_MULTI_ITEMS do
		if countX >= countZ then countX -= 1 else countZ -= 1 end
		if countX < 1 then countX = 1 break end
		if countZ < 1 then countZ = 1 break end
	end

	local dirX = (delta.X >= 0) and 1 or -1
	local dirZ = (delta.Z >= 0) and 1 or -1

	local cframes = {}
	for i = 0, countX - 1 do
		for j = 0, countZ - 1 do
			table.insert(cframes, startCF * CFrame.new(i * stepX * dirX, 0, j * stepZ * dirZ))
		end
	end
	return cframes
end

local function getMultiGhostFolder(): Folder
	if multiGhostFolder and multiGhostFolder.Parent then return multiGhostFolder end
	local temp = workspace:FindFirstChild("Temp")
	if not temp then
		temp = Instance.new("Folder")
		temp.Name = "Temp"
		temp.Parent = workspace
	end
	multiGhostFolder = Instance.new("Folder")
	multiGhostFolder.Name = "MultiPlaceGhosts"
	multiGhostFolder.Parent = temp
	return multiGhostFolder
end

local function clearMultiGhosts()
	for _, ghost in ipairs(multiGhosts) do
		if ghost and ghost.Parent then ghost:Destroy() end
	end
	table.clear(multiGhosts)

	if multiCountBillboard then
		multiCountBillboard:Destroy()
		multiCountBillboard = nil
		multiCountLabel = nil
	end
	if multiGhostFolder then
		multiGhostFolder:Destroy()
		multiGhostFolder = nil
	end
end

local function updateMultiCountLabel(count: number, canPlace: boolean)
	if count <= 1 then
		if multiCountBillboard then multiCountBillboard.Enabled = false end
		return
	end

	if not multiCountBillboard or not multiCountBillboard.Parent then
		multiCountBillboard = Instance.new("BillboardGui")
		multiCountBillboard.Name = "MultiPlaceCount"
		multiCountBillboard.Size = UDim2.fromOffset(90, 30)
		multiCountBillboard.StudsOffset = Vector3.new(0, 4, 0)
		multiCountBillboard.AlwaysOnTop = true
		multiCountBillboard.Parent = getMultiGhostFolder()

		multiCountLabel = Instance.new("TextLabel")
		multiCountLabel.Size = UDim2.fromScale(1, 1)
		multiCountLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		multiCountLabel.BackgroundTransparency = 0.25
		multiCountLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		multiCountLabel.TextScaled = true
		multiCountLabel.Font = Enum.Font.GothamBold
		multiCountLabel.Parent = multiCountBillboard

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = multiCountLabel
	end

	-- Adornee must be a BasePart. Several build prefabs are Models with no
	-- PrimaryPart set, and assigning a Model here throws -- fall back to any
	-- part in the model rather than trusting PrimaryPart to exist.
	local preview = PlacingService.GetPreview()
	local adornee: BasePart? = nil
	if preview then
		if preview:IsA("BasePart") then
			adornee = preview
		elseif preview:IsA("Model") then
			adornee = preview.PrimaryPart or preview:FindFirstChildWhichIsA("BasePart", true)
		end
	end
	if not adornee then
		multiCountBillboard.Enabled = false
		return
	end

	multiCountBillboard.Adornee = adornee
	multiCountBillboard.Enabled = true
	if multiCountLabel then
		multiCountLabel.Text = string.format("x%d", count)
		multiCountLabel.TextColor3 = canPlace and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 130, 130)
	end
end

-- Ghosts are recycled between frames rather than rebuilt: a drag updates on
-- every mouse-move, and re-cloning a dozen furniture models at that rate is
-- exactly the kind of thing that turns a smooth drag into a slideshow on a
-- phone. Only a change in COUNT ever allocates.
local function updateMultiGhosts(cframes: {CFrame}, canPlace: boolean)
	local preview = PlacingService.GetPreview()
	if not preview then return end

	-- Index 1 is the live preview itself, which PlacingService is already
	-- rendering -- ghosts cover slots 2..N.
	local needed = math.max(#cframes - 1, 0)

	for i = #multiGhosts, needed + 1, -1 do
		local ghost = multiGhosts[i]
		if ghost and ghost.Parent then ghost:Destroy() end
		multiGhosts[i] = nil
	end

	for i = #multiGhosts + 1, needed do
		local ghost = preview:Clone()
		for _, descendant in ipairs(ghost:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant.CanCollide = false
				descendant.CanQuery = false
				descendant.CanTouch = false
				descendant.Transparency = math.max(descendant.Transparency, 0.45)
			elseif descendant:IsA("ProximityPrompt") then
				descendant.Enabled = false
			end
		end
		if ghost:IsA("BasePart") then
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanQuery = false
			ghost.CanTouch = false
			ghost.Transparency = math.max(ghost.Transparency, 0.45)
		end
		ghost.Parent = getMultiGhostFolder()
		multiGhosts[i] = ghost
	end

	for i = 1, needed do
		local ghost = multiGhosts[i]
		if ghost then ghost:PivotTo(cframes[i + 1]) end
	end

	updateMultiCountLabel(#cframes, canPlace)
end

local function setMultiModeEnabled(enabled: boolean, fromUser: boolean?)
	multiModeEnabled = enabled
	if fromUser then multiModeUserChosen = true end

	if multiToggleButton then
		multiToggleButton.BackgroundColor3 = enabled
			and Color3.fromRGB(85, 200, 110)
			or Color3.fromRGB(163, 162, 165)
	end
	if multiToggleLabel then
		multiToggleLabel.Text = enabled and "MULTI" or "1x"
	end

	if not enabled then
		isMultiDragging = false
		PlacingService.IsMultiDragging = false
		multiDragStartCF = nil
		clearMultiGhosts()
	end
end

