-- ===== WALL EDGE HIGHLIGHT =====
-- Walls occupy a specific grid EDGE, and without seeing which one you're
-- targeting the snapping reads as arbitrary -- you only find out where the wall
-- went after committing. PlacingService publishes the chosen edge each frame;
-- this draws it.
local edgeHighlightPart: Part? = nil

local function getEdgeHighlightPart(): Part
	if edgeHighlightPart and edgeHighlightPart.Parent then return edgeHighlightPart end

	local temp = workspace:FindFirstChild("Temp")
	if not temp then
		temp = Instance.new("Folder")
		temp.Name = "Temp"
		temp.Parent = workspace
	end

	local part = Instance.new("Part")
	part.Name = "WallEdgeHighlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.Neon
	part.Transparency = 0.35
	part.Parent = temp

	edgeHighlightPart = part
	return part
end

local function hideEdgeHighlight()
	if edgeHighlightPart then
		edgeHighlightPart:Destroy()
		edgeHighlightPart = nil
	end
end

local function updateEdgeHighlight(canPlace: boolean)
	local edge = PlacingService.EdgeHighlight
	if not edge then
		hideEdgeHighlight()
		return
	end

	local part = getEdgeHighlightPart()
	part.Size = edge.Size
	part.CFrame = edge.CFrame
	part.Color = canPlace and canPlaceColor or cannotPlaceColor
end

local function hidePlacementUI()
	previewHighlight.Adornee = nil
	hideEdgeHighlight()
	cancelContainer.Visible = false

	-- Move mode must never survive the placement it belonged to: left on, it
	-- would keep camera panning suppressed with no preview on screen and no
	-- visible control explaining why the world had stopped responding.
	if setMoveMode then setMoveMode(false) end
	ContextActionService:UnbindAction(PLACEMENT_GAMEPAD_ACTION)
	currentObjectName = nil

	isMultiDragging = false
	PlacingService.IsMultiDragging = false
	multiDragStartCF = nil
	clearMultiGhosts()
end

local function confirmPlacement()
	local preview: Instance? = PlacingService.GetPreview()
	if not preview or not currentObjectName then return end

	local CF: CFrame = PlacingService._CF
	local canPlace: boolean = PlacingService.CanPlace
	if not canPlace or not CF then
		notifyCantPlace()
		return
	end

	preview:PivotTo(CF)
	events.Place:FireServer({
		ObjectName = currentObjectName,
		CF = CF,
		-- Which wall face this was mounted to. Only meaningful for WallSurface /
		-- FloorWallAnchored items; nil otherwise and the server ignores it. The
		-- server can't re-derive this from the CFrame once the player has rotated
		-- the item, so it has to travel with the placement.
		MountNormal = PlacingService.MountNormal,
		-- ITEM #10: the plot this Build Mode session is bound to. The server
		-- treats it strictly as a HINT -- it re-resolves and re-checks
		-- CanPlayerBuild itself, and ignores this if the two disagree -- but
		-- sending it means a guest builder's placement is attributed to the
		-- friend's plot they actually opened Build Mode against, rather than
		-- depending on the server's proximity resolution landing identically.
		TargetPlot = PlacingService.GetPlot(),
	})

	-- Keep the snap-node registry current so a just-placed wall is immediately
	-- a valid magnetic snap target for the next one (matters most when Ctrl is
	-- held to place several in a row without re-selecting the tool). Registered
	-- directly from the CFrame we just placed at -- NOT via RefreshWallNodes(),
	-- which re-scans the replicated plot and would race the server round-trip,
	-- missing the corner snap target if the next wall goes down quickly.
	if PlacementTypeConfig.Get(preview) == PlacementTypeConfig.Types.Wall then
		local _, previewSize: Vector3 = (function()
			if preview:IsA("Model") then
				local pCF: CFrame, size: Vector3 = preview:GetBoundingBox()
				return pCF, size
			else
				local pCF: CFrame, size: Vector3 = preview:GetPivot(), preview.Size
				return pCF, size
			end
		end)()
		PlacingService.RegisterWallNode(CF, previewSize)
	end

	if UserInputS:IsKeyDown(Enum.KeyCode.LeftControl) then return end

	previewTrove:Clean()
	PlacingService.Cancel()
	hidePlacementUI()
end

local function rotatePreview()
	if not PlacingService.GetPreview() then return end
	PlacingService.Rotate(Vector3.yAxis)
end

local function cancelPlacement()
	if not PlacingService.GetPreview() then return end

	previewTrove:Clean()
	PlacingService.Cancel()
	hidePlacementUI()
end

local function onGamepadPlacementInput(_, inputState, inputObject: InputObject)
	if inputState ~= Enum.UserInputState.Begin then return end

	if inputObject.KeyCode == Enum.KeyCode.ButtonA then
		confirmPlacement()
	elseif inputObject.KeyCode == Enum.KeyCode.ButtonY then
		rotatePreview()
	elseif inputObject.KeyCode == Enum.KeyCode.ButtonB then
		cancelPlacement()
	end

	return Enum.ContextActionResult.Sink
end

local DRAG_ROTATE_THRESHOLD = 6 -- pixels of movement before a press counts as a rotate-drag instead of a tap
local FLOOR_DRAG_THRESHOLD = 3 -- lower threshold so floor area dragging starts more responsively
local DRAG_ROTATE_SENSITIVITY = 0.02 -- radians per pixel of horizontal drag

local function getInputScreenPosition(inputObject: InputObject): Vector2
	return Vector2.new(inputObject.Position.X, inputObject.Position.Y)
end

local function startPlacing(object: Instance)
		previewTrove:Clean()
	currentObjectName = object.Name

	PlacingService.SetPreview(object)
	previewTrove:Connect(renderedEvent, function(preview: Model, _, canPlace: boolean)
		previewHighlight.Adornee = preview

		if canPlace then previewHighlight.OutlineColor, previewHighlight.FillColor = canPlaceColor, canPlaceColor
		else previewHighlight.OutlineColor, previewHighlight.FillColor = cannotPlaceColor, cannotPlaceColor end

		-- renderedEvent reports the OVERLAP/bounds result. PlacingService.CanPlace
		-- additionally factors in whether the item can mount on what's under the
		-- cursor, and a "this can't go there" surface rejection deserves the same
		-- on-screen explanation as a collision.
		updateBlockedBillboard(preview, canPlace and PlacingService.CanPlace)

		updateEdgeHighlight(canPlace)
	end)
	previewTrove:Add(hideEdgeHighlight)
	-- Cleared whenever the preview goes away (placed, cancelled, tool switched),
	-- otherwise the billboard would be left adorned to a destroyed preview.
	previewTrove:Add(function()
		updateBlockedBillboard(nil, true)
	end)

	-- Mouse click / touch tap confirms placement -- but holding and dragging
	-- (mouse or touch) free-rotates the preview toward the drag instead,
	-- matching Bloxburg's hold-to-rotate. A quick tap (little/no movement
	-- before release) still confirms; a drag never does.
	local isPressed = false
	local isDragRotating = false
	local pressStartPos = Vector2.zero
	local dragStartYaw = 0

	previewTrove:Connect(UserInputS.InputBegan, function(inputObject: InputObject, gameProcessedEvent: boolean)
		if gameProcessedEvent then return end

		local rotateY: Enum.KeyCode = Settings.RotateY
		local cancel: Enum.KeyCode = Settings.Cancel

		if inputObject.UserInputType == Enum.UserInputType.MouseButton1
			or inputObject.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			isDragRotating = false
			isFloorAreaDragging = false
			isMultiDragging = false
			pressStartPos = getInputScreenPosition(inputObject)
			dragStartYaw = PlacingService.GetRotationY()
			floorDragStartCF = PlacingService._CF
			multiDragStartCF = PlacingService._CF
		elseif inputObject.KeyCode == rotateY then
			rotatePreview()
		elseif inputObject.KeyCode == cancel then
			cancelPlacement()
		end
	end)

	previewTrove:Connect(UserInputS.InputChanged, function(inputObject: InputObject, gameProcessedEvent: boolean)
		if not isPressed or gameProcessedEvent then return end
		if inputObject.UserInputType ~= Enum.UserInputType.MouseMovement
			and inputObject.UserInputType ~= Enum.UserInputType.Touch then return end

		local currentPos = getInputScreenPosition(inputObject)
		local delta = currentPos - pressStartPos

		-- The MULTI button now gates BOTH drag paths, so "does dragging place
		-- more than one?" has a single visible answer for every item rather than
		-- floors silently behaving differently from everything else.
		if multiModeEnabled and isAreaFillPlacement() then
			-- Floors and ceiling tiles: dragging paints an area instead of rotating.
			if not isFloorAreaDragging and delta.Magnitude > FLOOR_DRAG_THRESHOLD then
				isFloorAreaDragging = true
			end
			if isFloorAreaDragging and floorDragStartCF and PlacingService._CF then
				updateAreaPreviewBox(floorDragStartCF, PlacingService._CF, PlacingService.CanPlace)
			end
			return
		end

		-- Multi mode intercepts the drag before the rotate handler below, so the
		-- same press can't be interpreted as both.
		if multiModeEnabled and supportsMultiPlace() then
			if not isMultiDragging and delta.Magnitude > MULTI_DRAG_THRESHOLD then
				isMultiDragging = true
				-- Suppress the wall magnet for the duration of the run.
				PlacingService.IsMultiDragging = true
			end
			if isMultiDragging and multiDragStartCF and PlacingService._CF then
				local cframes = computeMultiCFrames(multiDragStartCF, PlacingService._CF)
				updateMultiGhosts(cframes, PlacingService.CanPlace)
			end
			return
		end

		-- MOVE MODE: the drag is repositioning the item, not turning it. The
		-- preview already follows the finger for free -- PlacingService raycasts
		-- from UserInputService:GetMouseLocation(), which on touch tracks the last
		-- touch point -- so this only has to make sure the rotate gesture below
		-- does not also claim the same drag.
		if mobileMoveMode then return end

		-- Area-fill items have no rotate-drag gesture (a floor tile looks the same
		-- at every angle), so in 1x mode a drag on one simply does nothing.
		if isAreaFillPlacement() then return end

		if not isDragRotating and delta.Magnitude > DRAG_ROTATE_THRESHOLD then
			isDragRotating = true
			PlacingService.IsDragRotating = true
		end

		if isDragRotating then
			PlacingService.SetRotationY(dragStartYaw + (delta.X * DRAG_ROTATE_SENSITIVITY))
		end
	end)

	previewTrove:Connect(UserInputS.InputEnded, function(inputObject: InputObject)
		if not isPressed then return end
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1
			and inputObject.UserInputType ~= Enum.UserInputType.Touch then return end

		local wasDragRotating = isDragRotating
		local wasFloorAreaDragging = isFloorAreaDragging
		local wasMultiDragging = isMultiDragging
		isPressed = false
		isDragRotating = false
		isFloorAreaDragging = false
		isMultiDragging = false
		PlacingService.IsDragRotating = false
		PlacingService.IsMultiDragging = false
		hideAreaPreviewBox()

		if wasMultiDragging and multiDragStartCF and PlacingService._CF and currentObjectName then
			local cframes = computeMultiCFrames(multiDragStartCF, PlacingService._CF)
			clearMultiGhosts()
			multiDragStartCF = nil

			if not PlacingService.CanPlace then
				notifyCantPlace()
				return
			end

			-- A one-slot "drag" is just a tap that wobbled -- route it through the
			-- normal single-place path so it still respects Ctrl-to-keep-placing
			-- and the PlacementResult round-trip.
			if #cframes <= 1 then
				confirmPlacement()
				return
			end

			events.PlaceMulti:FireServer({
				ObjectName = currentObjectName,
				CFrames = cframes,
				MountNormal = PlacingService.MountNormal,
				TargetPlot = PlacingService.GetPlot(),
			})

			-- Same convention as single placement: hold Ctrl to stay in the tool
			-- and lay down another run without re-picking the item.
			if UserInputS:IsKeyDown(Enum.KeyCode.LeftControl) then return end

			previewTrove:Clean()
			PlacingService.Cancel()
			hidePlacementUI()
			return
		end
		multiDragStartCF = nil

		if wasFloorAreaDragging and floorDragStartCF and PlacingService._CF and currentObjectName then
			if not PlacingService.CanPlace then
				notifyCantPlace()
				floorDragStartCF = nil
				return
			end
			local cframes = computeAreaCFrames(floorDragStartCF, PlacingService._CF)
			events.PlaceArea:FireServer({
				ObjectName = currentObjectName,
				CFrames = cframes,
				TargetPlot = PlacingService.GetPlot(),
			})
			floorDragStartCF = nil
			return
		end
		floorDragStartCF = nil

		-- THE PREMATURE-PLACEMENT GUARD. In move mode, lifting your finger means
		-- "I have finished positioning", never "place it here". Committing is the
		-- Place button's job and nothing else's.
		if mobileMoveMode then return end

		if not wasDragRotating then
			confirmPlacement()
		end
	end)

	cancelItemLabel.Text = object.Name
	cancelContainer.Visible = true

	-- Every placeable item can be dragged now, so the toggle is always shown.
	-- Until the player presses it, each item starts in the mode that already
	-- suited it (floors/ceilings drag, everything else rotates); after that,
	-- their choice sticks across selections -- someone laying out a shop is
	-- placing several runs back to back and shouldn't re-arm it every time.
	ensureMultiToggleButton()
	if multiToggleButton then
		multiToggleButton.Visible = supportsAnyDrag()
	end
	if multiModeUserChosen then
		setMultiModeEnabled(multiModeEnabled)
	else
		setMultiModeEnabled(isAreaFillPlacement())
	end

	ContextActionService:BindActionAtPriority(
		PLACEMENT_GAMEPAD_ACTION,
		onGamepadPlacementInput,
		false,
		Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.ButtonY,
		Enum.KeyCode.ButtonB
	)
end

mobileAccept.Activated:Connect(confirmPlacement)
mobileRotate.Activated:Connect(rotatePreview)

-- ===== MOBILE: MOVE BUTTON =====
--
-- Built at runtime and cloned from RotateButton, the same approach the MULTI
-- toggle above already uses: it inherits the existing corner radius, gradient
-- and stroke rather than looking bolted on, and the whole feature stays in one
-- script instead of depending on a hand-placed instance a GUI restructure can
-- rename out from under it.
--
-- Sits as a full-width row ABOVE the icon row (which is itself positioned at
-- negative Y relative to CancelFrame), so it is the closest control to the
-- player's thumb and is a large target rather than a third squeezed icon.
local moveButton: ImageButton? = nil
local moveLabel: TextLabel? = nil

setMoveMode = function(enabled: boolean)
	mobileMoveMode = enabled
	-- Read by BuildCameraController's TouchMoved handler to suppress one-finger
	-- panning, so the world holds still while the item is being positioned.
	PlacingService.IsMobileMoving = enabled

	if moveButton then
		moveButton.BackgroundColor3 = enabled
			and Color3.fromRGB(85, 200, 110)
			or Color3.fromRGB(163, 162, 165)
	end
	if moveLabel then
		moveLabel.Text = enabled and "MOVING" or "MOVE"
	end
end

local function ensureMoveButton()
	if not TOUCH_ENABLED then return end
	if moveButton and moveButton.Parent then return end

	local clone = mobileRotate:Clone()
	clone.Name = "MoveButton"
	clone.Image = ""
	clone.Size = UDim2.new(1, 0, 0.5069, 0)
	clone.Position = UDim2.new(0, 0, -1.11, 0)
	clone.BackgroundColor3 = Color3.fromRGB(163, 162, 165)

	-- The cloned square aspect ratio would shrink this full-width row back to an
	-- icon-sized square (the same trap ensureMultiToggleButton documents).
	local aspect = clone:FindFirstChildOfClass("UIAspectRatioConstraint")
	if aspect then aspect:Destroy() end
	local innerIcon = clone:FindFirstChild("ImageLabel")
	if innerIcon then innerIcon:Destroy() end

	local label = Instance.new("TextLabel")
	label.Name = "ModeLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = "MOVE"
	label.Parent = clone

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = label

	clone.Parent = cancelFrame
	moveButton = clone
	moveLabel = label

	clone.Activated:Connect(function()
		setMoveMode(not mobileMoveMode)
	end)

	setMoveMode(false)
end

-- ===== MOBILE: SAFE AREA =====
--
-- GetGuiInset returns the space the Roblox topbar and the device's own chrome
-- (notch, rounded corners, home indicator) reserve. Build is a normal ScreenGui
-- with IgnoreGuiInset = false, so the engine already keeps the TOP clear -- but
-- nothing accounts for the bottom indicator, and on a short landscape phone the
-- controls can end up under it.
--
-- Applied as an offset on top of the existing scale position, so the layout the
-- artist authored is preserved on devices with no inset at all (every desktop),
-- and only nudged where there is real chrome to clear.
local function applySafeAreaPadding()
	if not TOUCH_ENABLED then return end

	-- Only the BOTTOM-RIGHT inset is applied. Build is a normal ScreenGui with
	-- IgnoreGuiInset = false, so the engine has already shifted the whole GUI
	-- space down past the topbar -- adding the top-left inset here as well would
	-- double-count it and push the controls further down the screen for no
	-- reason (measured: 29px of unwanted drop on a plain desktop viewport, where
	-- there is no device chrome to clear at all).
	--
	-- Absolute offsets derived from the authored scale position, never additive,
	-- so this is safe to re-run on every rotation and topbar change.
	local _, bottomRight = GuiService:GetGuiInset()
	local basePosition = cancelContainer.Position

	cancelContainer.Position = UDim2.new(
		basePosition.X.Scale,
		-math.max(bottomRight.X, 0),
		basePosition.Y.Scale,
		-math.max(bottomRight.Y, 0)
	)
end

ensureMoveButton()
applySafeAreaPadding()

-- The inset changes when the Roblox topbar shows/hides, and on a phone rotation
-- the whole viewport flips -- so this is recomputed rather than measured once at
-- join. Idempotent: it derives absolute offsets from the authored scale
-- position, so repeated calls cannot drift the layout.
if TOUCH_ENABLED then
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(applySafeAreaPadding)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(applySafeAreaPadding)
	end
end

local function setupCategory(category)
	local frame: ScrollingFrame = category.frame
	local template: TextButton = frame:FindFirstChild(category.templateName)
	if not template then return end

	template.Parent = nil

	local assetFolder: Folder? = shared.Assets:FindFirstChild(category.assetFolder)
	if not assetFolder then return end

	for _, object: Instance in assetFolder:GetChildren() do
		assert(
			object:IsA("BasePart") or object:IsA("Model"),
			`{object} is not a valid object`
		)

		local newButton = createButton(template, object, frame)

		newButton.MouseButton1Click:Connect(function()
			startPlacing(object)
		end)
	end
end

for _, category in categories do
	setupCategory(category)
end

-- ===== Category tabs =====
-- The 4 tab buttons (Furniture/Decorations/Construction/Inventory) and their
-- content frames existed in the GUI already, but nothing ever switched
-- between them -- Furniture just happened to be left Visible=true by default
-- and the other three were permanently hidden with no way to reach them.
local tabButtons = Build.ShopContainer.Buttons
-- Must list EVERY tab that has a button, because currentTabName -- which is
-- what the search box filters -- is only updated for names present here.
--
-- Utility was missing, so clicking it left currentTabName pointing at whichever
-- of the other tabs was selected last. CategorySwitcher still swapped the
-- visible frame, so the Utility tab appeared normally and then the search box
-- did nothing at all on it: every keystroke was filtering a frame the player
-- couldn't see.
local tabFrames = {
	Furniture = Build.ShopContainer.Furniture,
	Decorations = Build.ShopContainer.Decorations,
	Construction = Build.ShopContainer.Construction,
	Utility = Build.ShopContainer.Utility,
	Inventory = Build.ShopContainer.Inventory,
}

local currentTabName = "Furniture"

local function showTab(tabName: string)
	if not tabFrames[tabName] then return end
	currentTabName = tabName

	for name, frame in pairs(tabFrames) do
		frame.Visible = (name == tabName)
	end

	for _, button in ipairs(tabButtons:GetChildren()) do
		if button:IsA("ImageButton") then
			button.ImageTransparency = (button.Name == tabName) and 0 or 0.4
		end
	end
end

for _, button in ipairs(tabButtons:GetChildren()) do
	if button:IsA("ImageButton") and tabFrames[button.Name] then
		button.MouseButton1Click:Connect(function()
			showTab(button.Name)
		end)
	end
end

showTab("Furniture")

-- ===== Search =====
-- The search bar is always visible now (no more toggle button) and live-
-- filters whichever tab is currently open by item name -- switching tabs
-- while searching clears the filter so it never looks like a tab is just
-- missing items.
local searchBar: Frame = Build.ShopContainer:WaitForChild("SearchBar")
local searchTextBox: TextBox = searchBar:WaitForChild("SearchTextBox")
local searchClearButton: TextButton = searchBar:WaitForChild("ClearButton")

local function applySearchFilter(query: string)
	local frame = tabFrames[currentTabName]
	if not frame then return end

	local loweredQuery = string.lower(query)

	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiButton") and child.Name ~= "BuildTemplate" and child.Name ~= "InventoryTemplate" then
			child.Visible = (loweredQuery == "") or (string.find(string.lower(child.Name), loweredQuery, 1, true) ~= nil)
		end
	end
end

searchTextBox:GetPropertyChangedSignal("Text"):Connect(function()
	searchClearButton.Visible = searchTextBox.Text ~= ""
	applySearchFilter(searchTextBox.Text)
end)

searchClearButton.Activated:Connect(function()
	searchTextBox.Text = ""
	searchTextBox:CaptureFocus()
end)

-- Switching tabs while a search is active would otherwise leave the new tab
-- silently filtered by whatever was typed for the old one.
for _, button in ipairs(tabButtons:GetChildren()) do
	if button:IsA("ImageButton") and tabFrames[button.Name] then
		button.MouseButton1Click:Connect(function()
			if searchTextBox.Text ~= "" then
				searchTextBox.Text = ""
			end
		end)
	end
end

Build:GetPropertyChangedSignal("Enabled"):Connect(function()
	if not Build.Enabled then
		previewTrove:Clean()
		PlacingService.Cancel()
		hidePlacementUI()
	end
end)

do
	local function OnCharacterAdded(char: Model)
		for _, child: Instance in char:GetChildren() do
			if not child:IsA("BasePart") then continue end

			child.CollisionGroup = "Player"
		end
	end

	player.CharacterAdded:Connect(OnCharacterAdded)

	local char: Model? = player.Character
	if char then OnCharacterAdded(char) end
end
