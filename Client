local function setupViewport(viewportFrame: ViewportFrame, object: Instance)
	local clone: Instance = object:Clone()

	-- Keep the original rotation (only re-center position to the origin).
	-- CFrame.new(Vector3.zero) used to reset rotation to identity too, which
	-- happened to not matter for most items (they're already identity-rotated)
	-- but made the fix below meaningless if we ever add a pre-rotated item.
	local originalPivot = clone:GetPivot()
	clone:PivotTo(originalPivot - originalPivot.Position)

	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end

	clone.Parent = viewportFrame

	local camera = Instance.new("Camera")
	camera.Parent = viewportFrame
	viewportFrame.CurrentCamera = camera

	-- Placeable items (registers, racks, etc.) often carry invisible
	-- functional parts -- queue markers, employee stand zones, interaction
	-- volumes -- that are transparent and non-collidable but can stretch
	-- several studs beyond the actual visible furniture. Including them in
	-- the framing bounding box wrecks the preview zoom (e.g. cash registers
	-- were reading ~27 studs wide because of a 5-point queue line, when the
	-- visible register is only ~3-4 studs). Only frame on parts that are
	-- actually visible.
	local minBound, maxBound = nil, nil
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Transparency < 1 then
			local partCf, partSize = descendant.CFrame, descendant.Size
			local corners = {
				Vector3.new(-1, -1, -1), Vector3.new(1, -1, -1), Vector3.new(-1, 1, -1), Vector3.new(-1, -1, 1),
				Vector3.new(1, 1, -1), Vector3.new(1, -1, 1), Vector3.new(-1, 1, 1), Vector3.new(1, 1, 1),
			}
			for _, corner in corners do
				local worldCorner = partCf:PointToWorldSpace((partSize / 2) * corner)
				minBound = minBound and minBound:Min(worldCorner) or worldCorner
				maxBound = maxBound and maxBound:Max(worldCorner) or worldCorner
			end
		end
	end

	local center, size
	if minBound and maxBound then
		center = (minBound + maxBound) / 2
		size = maxBound - minBound
	else
		-- Fallback: no visible parts found (shouldn't happen), use full bounding box.
		local cf, boundSize = clone:GetBoundingBox()
		center, size = cf.Position, boundSize
	end

	local maxDim = math.max(size.X, size.Y, size.Z)
	local distance = maxDim * 1.5

	-- Frame from the item's front (LookVector), not a hardcoded world-space
	-- direction -- items conventionally face -Z, so a fixed +X/+Y/+Z camera
	-- offset was always looking at the BACK of every item (couches, registers,
	-- everything). Using the item's own orientation keeps this correct even
	-- if a future item isn't identity-rotated.
	local front = originalPivot.LookVector
	local right = originalPivot.RightVector
	local cameraPos = center + front * distance * 0.9 + right * distance * 0.6 + Vector3.new(0, distance * 0.6, 0)
	camera.CFrame = CFrame.new(cameraPos, center)
end

local function createButton(template: TextButton, object: Instance, parent: Frame)
	local newButton: TextButton = template:Clone()
	newButton.Name = object.Name
	newButton.Parent = parent

	local nameLabel: TextLabel? = newButton:FindFirstChild("BuildNameLabel")
	if nameLabel then
		nameLabel.Text = object.Name
	end

	local coinPriceLabel: TextLabel? = newButton:FindFirstChild("CoinPriceLabel")
	if coinPriceLabel then
		local coinPrice = object:GetAttribute("CoinPrice")
		if typeof(coinPrice) == "number" and coinPrice > 0 then
			coinPriceLabel.Text = tostring(coinPrice)
			coinPriceLabel.Visible = true
		else
			coinPriceLabel.Visible = false
		end
	end

	local diamondPriceLabel: TextLabel? = newButton:FindFirstChild("DiamondPriceLabel")
	if diamondPriceLabel then
		local diamondPrice = object:GetAttribute("DiamondPrice")
		if typeof(diamondPrice) == "number" and diamondPrice > 0 then
			diamondPriceLabel.Text = tostring(diamondPrice)
			diamondPriceLabel.Visible = true
		else
			diamondPriceLabel.Visible = false
		end
	end

	local viewportFrame: ViewportFrame? = newButton:FindFirstChild("ViewportFrame")
	if viewportFrame then
		if object:GetAttribute("TextOnly") == true then
			viewportFrame.Visible = false
		else
			setupViewport(viewportFrame, object)
		end
	end

	return newButton
end

local function isFloorPlacement(): boolean
	local preview = PlacingService.GetPreview()
	if not preview then return false end
	return preview:GetAttribute("IsFloor") == true
		or string.find(string.lower(preview.Name), "floor") ~= nil
end

-- How many BaseParts an asset is made of. Only SINGLE-part tiles can go down
-- the area-fill path, because the server collapses a whole drag into one
-- stretched part -- there's nothing sensible to stretch if the asset is a
-- multi-part model.
local function countParts(instance: Instance): number
	local n = instance:IsA("BasePart") and 1 or 0
	for _, d in ipairs(instance:GetDescendants()) do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

-- Ceiling TILES drag-fill exactly like floors. A Skylight is also a ceiling
-- item but is two parts (frame + glass), so it deliberately does NOT area-fill
-- -- it stays on the discrete multi-place path where each copy survives intact.
local function isCeilingTilePlacement(): boolean
	local preview = PlacingService.GetPreview()
	if not preview then return false end
	if PlacementTypeConfig.Get(preview) ~= PlacementTypeConfig.Types.Ceiling then return false end
	return countParts(preview) == 1
end

-- The single gate for "dragging paints a filled region" rather than rotating.
local function isAreaFillPlacement(): boolean
	return isFloorPlacement() or isCeilingTilePlacement()
end

-- The footprint one tile covers, used as the drag STEP.
--
-- This used to step by Settings.GridUnit (1 stud) while the tiles are 8x8,
-- which meant a drag emitted one CFrame per STUD instead of per TILE. The
-- server collapses them all into a single correctly-sized part either way, so
-- it looked fine -- but the charge is per CFrame, so a 24x24 floor (16 tiles,
-- 240 coins) was billing 625 cells = 9,375 coins. Stepping by the tile size
-- makes the count mean what it says.
local function getTileStep(): (number, number)
	local preview = PlacingService.GetPreview()
	local fallback = Settings.GridUnit or 1
	if not preview then return fallback, fallback end

	local size: Vector3
	if preview:IsA("Model") then
		local _, s = preview:GetBoundingBox()
		size = s
	else
		size = preview.Size
	end

	local x = (size.X > 0.05) and size.X or fallback
	local z = (size.Z > 0.05) and size.Z or fallback
	return x, z
end

