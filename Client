}

local function blockedMessage(): string
	if PlacingService.BlockedByOwnership then
		return BLOCKED_MESSAGES.Ownership
	end
	return BLOCKED_MESSAGES[PlacingService.BlockedReason] or "This can't be placed here!"
end

local function notifyCantPlace()
