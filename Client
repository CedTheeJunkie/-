-- One message for every possible cause tells the player nothing about what to do
-- differently -- "move the item", "buy land" and "aim at a wall" are three
-- unrelated fixes. PlacingService.BlockedReason says which one applies.
local BLOCKED_MESSAGES = {
	Overlap = "Not enough space!",
	Ownership = "Buy more land!",
	OutOfBounds = "That's outside your plot!",
