local function updateBlockedBillboard(preview: Instance?, canPlace: boolean)
	if canPlace or not preview then
		blockedBillboard.Enabled = false
		blockedBillboard.Adornee = nil
		return
	end

	-- Adornee must be a BasePart. A Model preview's PrimaryPart is often unset,
	-- so fall back to any part rather than silently rendering nothing.
	local adornee: BasePart? = nil
	if preview:IsA("BasePart") then
		adornee = preview
	elseif preview:IsA("Model") then
		adornee = preview.PrimaryPart or preview:FindFirstChildWhichIsA("BasePart", true)
	end
	if not adornee then
		blockedBillboard.Enabled = false
		return
	end

	blockedLabel.Text = blockedMessage()
	blockedLabel.TextColor3 = cannotPlaceColor
	blockedBillboard.Adornee = adornee
	blockedBillboard.Enabled = true
end

